# ==============================================================================
# DevFlow AI Environment Configuration Template
# Copy this file to .env and provide your environment-specific settings.
# NOTE: Never commit sensitive credentials or secret keys to source control.
# ==============================================================================

# Strands Decider 2B System One Endpoint
# Default local server: http://localhost:8099
STRANDS_DECIDER_URL=http://localhost:8099
STRANDS_DECIDER_MODEL_ID=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610

# Decision Policy
CONFIDENCE_THRESHOLD=0.60

# AWS Authentication & Amazon Bedrock Configuration
# Bedrock runtime uses standard boto3 credential resolution (IAM role, ~/.aws/credentials, or env)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Optional explicit credentials (prefer IAM roles or AWS profiles in production)
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_PLACEHOLDER
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_PLACEHOLDER
# AWS_SESSION_TOKEN=YOUR_AWS_SESSION_TOKEN_OPTIONAL
